deployall() {
    cd ~/code/main || return 1
    pwd
    git fetch
    echo "--------------------------------"
    git branch
    echo "--------------------------------"

    local latestBranchName
    latestBranchName=$(git for-each-ref --sort=-committerdate refs/heads/ refs/remotes/origin/ \
        --format='%(refname:short)' | sed 's/origin\///' | grep -v 'HEAD' | head -n 1)

    echo -n "Please input branch name [default: $latestBranchName]: "
    read -r branch_name

    if [ -z "$branch_name" ]; then
        branch_name="$latestBranchName"
    fi

    if [ -z "$branch_name" ]; then
        echo "Error: No branch found to deploy."
        return 1
    fi

