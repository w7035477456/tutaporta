{
  "name": "vettedSingles-api",
  "version": "1.0.0",
  "description": "Backend API server for OnlineMallWebsite",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server_be.js",
    "dev": "RUN_LOCAL_API_DEV=1 node --watch server_be.js",
    "build": "node --watch server_be.js",
    "seed": "node db/seed.js",
    "hash-password": "node scripts/hash-password.js",
    "migrate-password-argon2id": "node scripts/migratePasswordToArgon2id.js",
    "migrate-icon-vault-kdf": "node scripts/migrateIconVaultKdf.js",
    "rotate-record-vault-master-key": "node scripts/rotateRecordVaultIconKeysMasterKey.js",
    "verify-login": "node scripts/verify-login-password.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:logrotate-setup": "pm2 install pm2-logrotate && pm2 set pm2-logrotate:retain 7 && pm2 set pm2-logrotate:max_size 10M && pm2 set pm2-logrotate:compress true",
    "record-vault-bridge": "node recordVaultBridge/index.js",
    "record-vault-bridge:desktop": "npm --prefix recordVaultBridge/desktop start",
    "record-vault-bridge:dist:mac": "npm --prefix recordVaultBridge/desktop run dist:mac",
    "record-vault-bridge:dist:win": "npm --prefix recordVaultBridge/desktop run dist:win"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "^3.787.0",
    "@aws-sdk/client-polly": "^3.1101.0",
    "@aws-sdk/client-rekognition": "^3.1055.0",
    "@paypal/paypal-server-sdk": "^2.3.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bmp-js": "^0.1.0",
    "bpmn-engine": "^25.0.1",
    "bull": "^4.16.5",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decode-ico": "^0.4.1",
    "dotenv": "^16.3.1",
    "dotenv-expand": "^12.0.3",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "heic-decode": "^2.1.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.12",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "sql.js": "^1.14.1",
    "tesseract.js": "^5.1.1",
    "twilio": "^6.0.2",
    "unzipper": "^0.12.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
