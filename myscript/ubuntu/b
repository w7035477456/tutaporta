# --- secure_all_in_one.sh ---
# Configures UFW for a combined HAProxy / Web / DB node
# Targets: Port 59221 (SSH), 50010 (Postgres), 40000 (App)

allinoneufw() {
    echo "🛡️  Starting Unified UFW Configuration..."

    # 1. Reset & Defaults
    sudo ufw --force reset
    sudo ufw default deny incoming
    sudo ufw default allow outgoing

    # 2. Disable IPv6 (Matching your original logic)
    if grep -q '^IPV6=yes' /etc/default/ufw; then
        sed -i 's/^IPV6=yes/IPV6=no/' /etc/default/ufw
        echo "IPv6 disabled in UFW config."
    fi

    # 3. SSH Lockdown (Port 59221 from your Trusted Mac)
    # Using the IP from your original script: 192.168.44.104
    sudo ufw allow from 192.168.44.104 to any port 59221 proto tcp
    sudo ufw deny 22/tcp
    echo "SSH secured on port 59221 for trusted IP."

    # 4. Loopback (Essential for internal Postgres/App comms)
    sudo ufw allow in on lo
    sudo ufw allow out on lo

    # 5. Combined Role Rules
    echo "Applying HAProxy, Webserver, and Postgres rules..."
    
    # Web Traffic (HAProxy)
    sudo ufw allow 80/tcp
    sudo ufw allow 443/tcp
    
    # Internal Nginx/App Traffic
    sudo ufw allow from 127.0.0.1 to any port 10000 proto tcp
    sudo ufw allow from 127.0.0.1 to any port 40000 proto tcp

    # Postgres (Primary/Replica)
    sudo ufw allow in on lo to any port 50010 proto tcp

    # 6. Enable
    sudo ufw --force enable
    sudo ufw status verbose
    echo "✅ UFW secured and active for All-in-One Node."
}

