[Unit]
Description=OnlineMall website uptime monitor (curl + SMS + USB speaker, not PM2)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
SupplementaryGroups=audio
Environment=HOME=__HOME_DIR__
Environment=XDG_RUNTIME_DIR=/run/user/__RUN_UID__
WorkingDirectory=__HOME_DIR__
ExecStart=__SCRIPT_PATH__
Restart=always
RestartSec=5
# control-group so the speaker-test child dies with the monitor
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
