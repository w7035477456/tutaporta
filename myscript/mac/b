update_psql() {
    local table sel_col sel_val tar_col tar_val
    
    # Connection details from your alias
    local DB_HOST="127.0.0.1"
    local DB_PORT="50010"
    local DB_USER="test_user1"
    local DB_NAME="onlinemallwebsite"

    # 1. Table Name
    read -p "Enter table name:[singles] " table
    table=${table:-singles}

    # 2. Select Column
    read -p "Enter select column name: [email] " sel_col
    sel_col=${sel_col:-email}

    # 3. Select Value (Required)
    while [[ -z "$sel_val" ]]; do
        read -p "Enter select column value: " sel_val
        [[ -z "$sel_val" ]] && echo "Error: Value required."
    done

    # 4. Target Column (Required)
    while [[ -z "$tar_col" ]]; do
        read -p "Enter target column name: " tar_col
        [[ -z "$tar_col" ]] && echo "Error: Value required."
    done

    # --- VERIFICATION SELECT (Input 2, Input 4 from Input 1) ---
    echo -e "\n--- Current Values ---"
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c "SELECT $sel_col, $tar_col FROM $table WHERE $sel_col = '$sel_val';"
    echo ""

    # 5. Target Value (Required)
    while [[ -z "$tar_val" ]]; do
        read -p "Enter target value to update: " tar_val
        [[ -z "$tar_val" ]] && echo "Error: Value required."
    done

    # SQL Construction
    sql_update="UPDATE $table SET $tar_col = '$tar_val' WHERE $sel_col = '$sel_val';"
    # Final Select to show the specific updated row
    sql_final="SELECT $tar_col, $sel_col FROM $table WHERE $sel_col = '$sel_val' OR $tar_col = '$tar_val';"

    echo -e "\n--- Executing Update ---"
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c "$sql_update"
    
    echo -e "\n--- Final Result ---"
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c "$sql_final"
}

