# Delete a git branch locally and on origin (prompts for name).
git_branch_delete_both() {
  local branch current_repo

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not inside a git repo." >&2
    return 1
  fi

  read -r -p "Branch name to delete: " branch
  branch="${branch#"${branch%%[![:space:]]*}"}"
  branch="${branch%"${branch##*[![:space:]]}"}"

  if [[ -z "$branch" ]]; then
    echo "No branch name entered." >&2
    return 1
  fi

  case "$branch" in
    main|master)
      echo "Refusing to delete protected branch: $branch" >&2
      return 1
      ;;
  esac

  current_repo="$(git branch --show-current 2>/dev/null)"
  if [[ "$branch" == "$current_repo" ]]; then
    echo "You are on '$branch'. Switch branch first, e.g.: git checkout main" >&2
    return 1
  fi

  local has_local=0 has_remote=0
  git show-ref --verify --quiet "refs/heads/$branch" && has_local=1
  git show-ref --verify --quiet "refs/remotes/origin/$branch" && has_remote=1

  if [[ $has_local -eq 0 && $has_remote -eq 0 ]]; then
    echo "Branch '$branch' not found locally or on origin." >&2
    return 1
  fi

  echo "Will delete:"
  [[ $has_local -eq 1 ]] && echo "  local:  $branch"
  [[ $has_remote -eq 1 ]] && echo "  remote: origin/$branch"
  read -r -p "Type branch name to confirm: " confirm
  if [[ "$confirm" != "$branch" ]]; then
    echo "Cancelled (confirmation did not match)." >&2
    return 1
  fi

  if [[ $has_local -eq 1 ]]; then
    if git branch -d "$branch" 2>/dev/null; then
      echo "Deleted local branch: $branch"
    elif git branch -D "$branch"; then
      echo "Force-deleted local branch: $branch"
    else
      echo "Failed to delete local branch: $branch" >&2
      return 1
    fi
  fi

  if [[ $has_remote -eq 1 ]]; then
    if git push origin --delete "$branch"; then
      echo "Deleted remote branch: origin/$branch"
    else
      echo "Failed to delete remote branch: origin/$branch" >&2
      return 1
    fi
  fi

  echo "Done."
}

