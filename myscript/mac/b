bigfiles() {
  local n="${1:-}"

  if [[ -z "$n" ]]; then
    read -rp "How many biggest files? " n
  fi

  if ! [[ "$n" =~ ^[0-9]+$ ]] || (( n < 1 )); then
    echo "bigfiles: need a positive number (e.g. bigfiles 10)" >&2
    return 1
  fi

  local root
  root="$(pwd)"

  find "$root" -type f -print0 2>/dev/null \
    | while IFS= read -r -d '' f; do
        if stat --version >/dev/null 2>&1; then
          stat -c '%s %n' "$f"          # Ubuntu / GNU
        else
          stat -f '%z %N' "$f"          # macOS / BSD
        fi
      done \
    | sort -t' ' -k1,1nr \
    | head -n "$n" \
    | awk '{
        bytes = $1
        $1 = ""
        sub(/^ /, "")
        path = $0
        s = bytes
        split("B KB MB GB TB PB", u, " ")
        i = 1
        while (s >= 1024 && i < 6) { s /= 1024; i++ }
        printf "%10.1f %-4s  %s\n", s, u[i], path
      }'
}


