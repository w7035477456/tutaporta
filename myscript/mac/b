dbMergeRestore() {
    DUMP_DIR="$HOME/dbFolder"
    TODAY=$(date +"%m%d%Y")
    LIVE_SCHEMA="helloworldjunktest"
    TMP_SCHEMA="helloworldjunktest_merge_tmp"

    clear
    echo "--- MERGE DB restore (preserve existing) ---"
    echo "--- Current files in $DUMP_DIR ---"
    if [ -d "$DUMP_DIR" ]; then
        ls -latr "$DUMP_DIR"
    else
        echo "Directory $DUMP_DIR not found."
    fi
    echo "-----------------------------------"

    printf "Wormhole postfix only? [default: skip]: "
    read WORM_POSTFIX
    if [ -n "$WORM_POSTFIX" ]; then
        cd "$DUMP_DIR" || return 1
        echo "Attempting wormhole receive..."
        local RECV_OUT="$DUMP_DIR/wormhole_recv_${TODAY}_$(date +%H%M%S).sql"
        if ! wormhole receive --accept-file -o "$RECV_OUT" "$WORM_POSTFIX"; then
            echo "Warning: wormhole receive failed."
            if [ -z "$ALL_RESTORE" ]; then
                echo "You can still merge from an existing .sql in $DUMP_DIR."
            fi
        fi
    fi

    LATEST_FILE=$(ls -t "$DUMP_DIR"/*.sql 2>/dev/null | head -n 1)
    DEFAULT_VAL=$(basename "$LATEST_FILE" 2>/dev/null)

    if [ -z "$DEFAULT_VAL" ]; then
        PROMPT_TEXT="Enter file to merge-restore: "
    else
        PROMPT_TEXT="Enter file to merge-restore [default: $DEFAULT_VAL]: "
    fi
    printf "%s" "$PROMPT_TEXT"
    read USER_INPUT

    if [ -z "$USER_INPUT" ]; then
        if [ -z "$DEFAULT_VAL" ]; then
            echo "Error: No default file found and no input provided."
            return 1
        fi
        RESTORE_FILE="$DEFAULT_VAL"
    else
        if [[ "$USER_INPUT" != *.sql ]]; then
            RESTORE_FILE="${USER_INPUT}${TODAY}.sql"
        else
            RESTORE_FILE="$USER_INPUT"
        fi
    fi

    FULL_PATH="$DUMP_DIR/$RESTORE_FILE"
    if [ ! -f "$FULL_PATH" ]; then
        echo "Error: File $FULL_PATH not found."
        return 1
    fi

    if [ -n "$ALL_RESTORE" ]; then
        echo "allMergeRestore: merging $RESTORE_FILE (auto-confirmed)."
    else
        printf "Confirm MERGE (keep existing, add missing) from %s? [Y/n]: " "$RESTORE_FILE"
        read CONFIRM
        if [[ "$CONFIRM" == "n" || "$CONFIRM" == "N" ]]; then
            echo "Merge restore cancelled."
            return 1
        fi
    fi

    local PSQL=(psql -U test_user1 -h 127.0.0.1 -p 50010 -d onlinemallwebsite)
    local REWRITE_SQL="$DUMP_DIR/.merge_rewrite_$$.sql"

    echo "Loading dump into temp schema $TMP_SCHEMA (live schema untouched)..."
    "${PSQL[@]}" -v ON_ERROR_STOP=1 -c "DROP SCHEMA IF EXISTS ${TMP_SCHEMA} CASCADE;"
    sed "s/${LIVE_SCHEMA}/${TMP_SCHEMA}/g" "$FULL_PATH" > "$REWRITE_SQL"
    if ! "${PSQL[@]}" -v ON_ERROR_STOP=1 -f "$REWRITE_SQL"; then
        echo "Error: failed importing dump into temp schema."
        rm -f "$REWRITE_SQL"
        return 1
    fi
    rm -f "$REWRITE_SQL"

    echo "Merging rows into ${LIVE_SCHEMA} (ON CONFLICT DO NOTHING — existing wins)..."
    "${PSQL[@]}" -v ON_ERROR_STOP=1 <<SQL
SET session_replication_role = replica;
DO \$\$
DECLARE
  r RECORD;
  n bigint;
  live_reg regclass;
BEGIN
  FOR r IN
    SELECT c.relname AS tbl
    FROM pg_class c
    JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = '${TMP_SCHEMA}'
      AND c.relkind IN ('r', 'p')
      AND NOT c.relispartition
    ORDER BY c.relname
  LOOP
    live_reg := to_regclass(format('%I.%I', '${LIVE_SCHEMA}', r.tbl));
    IF live_reg IS NULL THEN
      EXECUTE format(
        'CREATE TABLE %I.%I (LIKE %I.%I INCLUDING ALL)',
        '${LIVE_SCHEMA}', r.tbl, '${TMP_SCHEMA}', r.tbl
      );
      RAISE NOTICE 'created missing table %.%', '${LIVE_SCHEMA}', r.tbl;
    END IF;
    BEGIN
      EXECUTE format(
        'INSERT INTO %I.%I SELECT * FROM %I.%I ON CONFLICT DO NOTHING',
        '${LIVE_SCHEMA}', r.tbl, '${TMP_SCHEMA}', r.tbl
      );
      GET DIAGNOSTICS n = ROW_COUNT;
      RAISE NOTICE 'merged %: % new row(s)', r.tbl, n;
    EXCEPTION WHEN OTHERS THEN
      RAISE WARNING 'skip table %: %', r.tbl, SQLERRM;
    END;
  END LOOP;
END \$\$;
SET session_replication_role = DEFAULT;

DO \$\$
DECLARE
  r RECORD;
  live_last bigint;
  tmp_last bigint;
BEGIN
  FOR r IN
    SELECT sequencename
    FROM pg_sequences
    WHERE schemaname = '${LIVE_SCHEMA}'
  LOOP
    IF to_regclass(format('%I.%I', '${TMP_SCHEMA}', r.sequencename)) IS NULL THEN
      CONTINUE;
    END IF;
    EXECUTE format('SELECT last_value FROM %I.%I', '${LIVE_SCHEMA}', r.sequencename) INTO live_last;
    EXECUTE format('SELECT last_value FROM %I.%I', '${TMP_SCHEMA}', r.sequencename) INTO tmp_last;
    IF tmp_last IS NOT NULL AND (live_last IS NULL OR tmp_last > live_last) THEN
      EXECUTE format(
        'SELECT setval(%L, %s, true)',
        format('%I.%I', '${LIVE_SCHEMA}', r.sequencename),
        tmp_last
      );
      RAISE NOTICE 'sequence % advanced to %', r.sequencename, tmp_last;
    END IF;
  END LOOP;
END \$\$;
SQL

    echo "Dropping temp schema ${TMP_SCHEMA}..."
    "${PSQL[@]}" -c "DROP SCHEMA IF EXISTS ${TMP_SCHEMA} CASCADE;"
    echo "--- Verification: Tables ---"
    "${PSQL[@]}" -c "\dt ${LIVE_SCHEMA}.*"
    echo "DB merge restore completed (existing data preserved)."
}

