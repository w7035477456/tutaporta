"/var/lib/postgresql/16/main/postgresql.auto.conf"
"/var/lib/postgresql/16/main/standby.signal"
    )

for item in "${items[@]}"; do
        if [ -e "$item" ]; then
            echo "  -> Backing up: $item"
            # -R (relative) recreates the path inside the target
            # -a (archive) preserves permissions/timestamps
            sudo rsync -Ra "$item" "$abs_target/"
        else
            echo "  [?] Path not found, skipping: $item"
        fi
    done

    echo " [+] Fixing ownership for: $USER"
    sudo chown -R "$USER" "$abs_target"
    echo " [✓] Completed. Files are in: $abs_target"
}

