# Redis password from REDIS_URL in ~/.ssh/be/.env (same as Node). Bare redis-cli needs -a or NOAUTH.
_redis_cli_auth() {
  local url pass host port
  url=$(grep -E '^[[:space:]]*REDIS_URL=' "$HOME/.ssh/be/.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' | tr -d "'")
  host=127.0.0.1
  port=6379
  pass=""
  if [[ -n "$url" ]]; then
    # redis://:password@host:port  or  redis://user:password@host:port
    if [[ "$url" =~ redis://([^:@]*):([^@]+)@([^:/]+)(:([0-9]+))? ]]; then
      pass="${BASH_REMATCH[2]}"
      host="${BASH_REMATCH[3]}"
      [[ -n "${BASH_REMATCH[5]}" ]] && port="${BASH_REMATCH[5]}"
    fi
  fi
  if [[ -z "$pass" ]]; then
    echo "[redis] REDIS_URL password not found in ~/.ssh/be/.env" >&2
    return 1
  fi
  # -n suppresses password warning on stdout
  redis-cli -h "$host" -p "$port" -a "$pass" --no-auth-warning "$@"
}

