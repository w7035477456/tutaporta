mygrep() {
    local search_string
    local file_ext

    # 1) Ask for the string to grep
    read -p "Please enter string to grep: " search_string

    # 2) Ask for the extension with a default
    read -p "Please enter file extension to grep [default: *.js, *.jsx]: " file_ext

    # If the user presses enter (string is empty), set the default
    if [ -z "$file_ext" ]; then
        # We use a brace expansion for multiple extensions in grep
        # Using --include multiple times or a glob pattern
        grep -rn "$search_string" --include="*.js" --include="*.jsx" .
    else
        grep -rn "$search_string" --include="$file_ext" .
    fi
}

