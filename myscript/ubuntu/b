# Function to restore the onlinemallwebsite database on Ubuntu
dbRestore() {
    DUMP_DIR="$HOME/dbFolder"
    # Note: %d/%m/%Y vs %m%d%Y - adjusted to match your screenshot's pattern
    TODAY=$(date +"%m%d%Y")

    # Step 1: Clear and list files
    clear
    echo "--- Current files in $DUMP_DIR ---"
    # Ensure directory exists before listing
    if [ -d "$DUMP_DIR" ]; then
        ls -latr "$DUMP_DIR"
    else
        echo "Directory $DUMP_DIR not found."
    fi
    echo "-------------------------------------"

    # Step 2: Wormhole receive
    # Ubuntu bash 'read' syntax: read -p "Prompt: " VARIABLE
    read -p "Wormhole postfix only? [default: skip]: " WORM_POSTFIX

    if [ -n "$WORM_POSTFIX" ]; then
        # Check if dir exists before cd
        cd "$DUMP_DIR" || return 1

        echo "Attempting wormhole receive..."
        # We use --accept-file to automate
        wormhole receive --accept-file "$WORM_POSTFIX"
    fi

    # Step 3: Determine Default File
    # Using 'head -n 1' to find the most recent .sql file
    LATEST_FILE=$(ls -t "$DUMP_DIR"/*.sql 2>/dev/null | head -n 1)
    DEFAULT_VAL=$(basename "$LATEST_FILE" 2>/dev/null)

    if [ -z "$DEFAULT_VAL" ]; then
        PROMPT_TEXT="Enter file to restore: "
    else
        PROMPT_TEXT="Enter file to restore [default: $DEFAULT_VAL]: "
    fi

    read -p "$PROMPT_TEXT" USER_INPUT

    # Step 4: Logic for Input vs Default
    if [ -z "$USER_INPUT" ]; then
        if [ -z "$DEFAULT_VAL" ]; then
            echo "Error: No default file found and no input provided."
            return 1
        fi
        RESTORE_FILE="$DEFAULT_VAL"
    else
        # Bash string matching
        if [[ "$USER_INPUT" != *.sql ]]; then
            RESTORE_FILE="${USER_INPUT}${TODAY}.sql"
        else
            RESTORE_FILE="$USER_INPUT"
        fi
    fi

    FULL_PATH="$DUMP_DIR/$RESTORE_FILE"

    if [ ! -f "$FULL_PATH" ]; then
        echo "Error: File $FULL_PATH not found."
        return 1
    fi

    # MODIFIED: Default to 'y' on Enter
    read -p "Confirm restore file $RESTORE_FILE? [Y/n]: " CONFIRM
    if [[ "${CONFIRM,,}" == "n" ]]; then
        echo "Restore cancelled."
        return 1
    fi

    # --- PASSWORD HANDLING ---
    # Prompt for the database password once, silently (-s)
    read -s -p "Enter password for test_user1: " PGPASSWORD
    echo "" # Newline for clean output formatting
    export PGPASSWORD

    # 4. Clean Database
    # Using the credentials for your onlinemallwebsite database
    echo "Dropping existing schema..."
    psql -U test_user1 -h 127.0.0.1 -p 50010 -d onlinemallwebsite -c "DROP SCHEMA IF EXISTS helloworldjunktest CASCADE;"

    # 5. Import
    echo "Importing ${FULL_PATH}..."
    # -v ON_ERROR_STOP=1 ensures we don't keep running if a query fails
    psql -U test_user1 -h 127.0.0.1 -p 50010 -d onlinemallwebsite \
        -v ON_ERROR_STOP=1 \
        --set=search_path=helloworldjunktest,public \
        -f "$FULL_PATH"

    # 6. Verification
    echo "--- Verification: Tables in onlinemallwebsite ---"
    psql -U test_user1 -h 127.0.0.1 -p 50010 -d onlinemallwebsite -c "\dt helloworldjunktest.*"

    # --- CLEANUP ---
    # Unset to prevent the password from lingering in your terminal session
    unset PGPASSWORD

    echo "Restore process completed."
}

