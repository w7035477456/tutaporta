scpDB() {
# Navigate to the folder first, with a safety check
    cd ~/dbFolder || { echo "Error: Could not navigate to ~/dbFolder"; return 1; }
    
    # Find the most recently modified .sql file
    local latest_file=$(ls -t *.sql 2>/dev/null | head -n 1)
    local filename=""

    # If a .sql file was found, prompt the user
    if [ -n "$latest_file" ]; then
        read -p "Transfer $latest_file (Y/n) ? " choice
        
        # Default to 'Y' if the user simply presses Enter
        choice=${choice:-Y}
        
        if [[ "$choice" == [Yy]* ]]; then
            filename="$latest_file"
        elif [[ "$choice" == [Nn]* ]]; then
            read -p "Enter the file name to transfer: " filename
        else
            echo "Invalid choice. Transfer cancelled."
            return 1
        fi
    else
        # Fallback in case there are no .sql files in the directory
        read -p "No .sql files found. Enter the file name to transfer: " filename
    fi

    # Execute the scp command if a filename was successfully captured
    if [ -n "$filename" ]; then
        scp "$filename" xbox2:~/dbFolder/
    else
        echo "No file provided. Transfer cancelled."
    fi
}


