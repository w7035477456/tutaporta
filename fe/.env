DEFAULT_THEME=Ocean light

DISABLE_NAVIGATION_COLLAPSE=false

# Button label hover growth (1.25 = +25% font size; button box stays same size)
HOVER_MAGNIFY_FACTOR=1.30

# FE_RATE_* — ~/.ssh/be/.env (mirrored into Vite bundle at startup; see fe/vite.config.mjs)

MAIN_FONT=Algerian, fantasy

FE_CHAT_SOCKET=false
# should turn if false for productin, true for debugging
FE_DEBUG=false
# Bottom-left rate limit debug HUD (bar + stats). true = show, false = hide all RL debug UI.
#RATE_LIMIT_DEBUG=false

VITE_APP_VERSION=v5.1.0
GENERATE_SOURCEMAP=false

## PUBLIC URL
VITE_APP_BASE_NAME=/
# Backend API port (used by be/server via loadEnv.js and by Vite client via import.meta.env.API_PORT)
API_PORT=40000

SHOW_ZOOM=true
# Lower-left overlay: window inner width x height (px) + B (md+) / M (below md). See ViewportSizeReadout.jsx
VITE_SHOW_VIEWPORT_SIZE=true
# Optional: full API origin; when set, overrides API_PORT for the frontend
#VITE_API_BASE_URL=http://localhost:40000
#VITE_API_BASE_URL=https://vsingles.club


RECORD_VIDEO_TO_VW_RATIO=0.5
YELLOW_TEXT_BANNER_TO_VH_RATIO=0.25


# Sidebar nav: true = long-press keeps zoom; false = long-press suppresses zoom (quick tap still zooms). See config/pressHoldZoomEnv.js
PRESS_HOLD_TO_ZOOM=false
# Mobile All Singles / Interested: numeric value becomes N vw (see config/singlesMemberCardFontEnv.js)
MOBILE_FONT_SIZE_TEXT=4
MOBILE_FONT_SIZE_TITLE=3
MOBILE_FONT_SIZE_BUTTON=6
MOBILE_FONT_SIZE_MENU=8

# in vw unit
DESKTOP_FONT_SIZE_TEXT=1.5
DESKTOP_FONT_SIZE_TITLE=2
DESKTOP_FONT_SIZE_BUTTON=2
BSIZE=2
DESKTOP_FONT_SIZE_ICON=2
DESKTOP_FONT_SIZE_MENU=4

DESKTOP_ICON_SIZE=3

# in rem unit
THEME_ICON_SIZE=4
NOTIFICATION_ICON_SIZE=4


TOOLTIP_DIALGO_WIDTH=

HOVER_ENLARGE_FACTOR=1.15
# My Picks left-column cards — numeric N becomes Nvw / Nvh (see config/myPicksCardEnv.js)
MY_PICKS_COLUMN_VW=21
MY_PICKS_COLUMN_VH=32
MY_PICKS_AVATAR_VW=9.2
MY_PICKS_AVATAR_VH=12
MY_PICKS_AVATAR_MOBILE_VW=28
# Remove X: fraction of half DESKTOP_ICON_SIZE (0.75 = 25% smaller)
MY_PICKS_REMOVE_X_SCALE=0.75



# Mobile auth dialogs: scrollbars only when true (see config/authDialogEnv.js, vite envPrefix VERTICAL_/HORIZONTAL_)
VERTICAL_SCROLLBAR=false
HORIZONTAL_SCROLLBAR=false

# MainCard (green) + AuthInnerStack (purple) debug outlines; true to show, false or omit to hide
DEBUG_DOTTED_BORDERS=false
# Red global ERROR dialog on console.error; true only to show it (see config/globalErrorPopupEnv.js)
GLOBAL_ERROR_POPUP=false

# Black fixed footer bar height (% of VH) — entire site; not the About/Terms/Privacy dialog margins
FOOTER_HEIGHT=4
# About Us / Terms & Privacy scroll column margins (% of VH / VW)
FOOTERPAGES_TOP_MARGIN=2
FOOTERPAGES_BOT_MARGIN=4
FOOTERPAGES_RIGHT_LEFT_MARGIN=2

# Standard auth dialogs: DIALOG_WIDTH_MOBILE (xs–sm), DIALOG_WIDTH_DESKTOP (md+). Margins vh. Scroll if content exceeds 100dvh minus top and bottom.
DIALOG_WIDTH_MOBILE=90
DIALOG_WIDTH_DESKTOP=50
DIALOG_MARGIN_TOP=2
DIALOG_MARGIN_BOT=4

VSINGLES_SONG=song2.mp3

# /myPicks: skip duplicate list/feed/bell refresh on page visit (SWR already loads). Restart Vite after change.
# true = old behavior (extra refresh on every visit). false or unset = dedupe (default).
#VITE_MY_PICKS_LEGACY_REFRESH=true



# When true: mall Tuta Albums / Tuta Notes show upgrade popup (no navigate). Mirrored from ~/.ssh/be/.env when set.
ONENOTE_USB_UPGRADE=false
