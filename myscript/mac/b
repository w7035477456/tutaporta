git-delete-branch() {
    # 1. Ask for the branch name
    read -p "Enter the branch name to delete: " branch_name

    # Strip any accidental whitespace
    branch_name=$(echo "$branch_name" | xargs)

    # Exit if no input was provided
    if [ -z "$branch_name" ]; then
        echo "❌ Error: Branch name cannot be empty."
        return 1
    fi

    # 2. Safety check: Ensure we aren't trying to delete the current branch
    current_branch=$(git branch --show-current)
    if [ "$branch_name" = "$current_branch" ]; then
        echo "❌ Error: You cannot delete the branch you are currently on ('$current_branch')."
        echo "Please switch to another branch (e.g., git checkout main) and try again."
        return 1
    fi

    echo "----------------------------------------"
    echo "Preparing to delete branch: '$branch_name'"
    echo "----------------------------------------"

    # 3. Delete Local Branch
    echo "⏳ Deleting local branch..."
    if git branch -d "$branch_name" 2>/dev/null; then
        echo "✅ Successfully deleted local branch."
    else
        # If safe delete fails (unmerged changes), ask for a force-delete confirmation
        read -p "⚠️  Branch has unmerged changes. Force delete locally? (y/N): " confirm_force
        if [[ "$confirm_force" =~ ^[Yy]$ ]]; then
            git branch -D "$branch_name"
            echo "🔥 Force deleted local branch."
        else
            echo "❌ Local deletion aborted."
            return 1
        fi
    fi

    # 4. Delete Remote Branch
    read -p "🌐 Delete from remote 'origin' as well? (y/N): " confirm_remote
    if [[ "$confirm_remote" =~ ^[Yy]$ ]]; then
        echo "⏳ Deleting remote branch..."
        if git push origin --delete "$branch_name"; then
            echo "✅ Successfully deleted remote branch."
            # Clean up local tracking references
            git fetch origin --prune
        else
            echo "❌ Failed to delete remote branch (it may not exist on origin)."
        fi
    fi

    echo "✨ Done."
}
