        export FE_BUILD_SCRIPT=buildprodnoobfuscate
        echo "=== work2: FE build = npm run buildprodnoobfuscate (no obfuscate) ==="
    else
        export FE_BUILD_SCRIPT=buildprod
        echo "=== work2: FE build = npm run buildprod (with obfuscate) ==="
    fi

    # 4) Build/deploy (requires febeprod above — hard-stops if fe/dist missing)
    if ! type febeprod >/dev/null 2>&1; then
        echo "ERROR: febeprod not defined. Run: source ~/b" >&2
        return 1
    fi
    echo "=== work2: febeprod (FE build must produce fe/dist before BE) ==="
    if ! febeprod; then
        echo "ERROR: work2 deploy aborted — febeprod failed (see FE dist / build errors above)" >&2
        return 1
    fi
    git branch

    makeSound
    # 5) Recent logs only — pm2log uses --nostream so work2 exits (use pm2logf to follow)
    pm2log
}

# Same steps as work2, non-interactive — Mac deployall2 / deploy-all.sh call this over SSH.
# Uses febeprod from this file (myscript/ubuntu/b). Do NOT source ~/b over SSH (keychain prompts).
# GitHub SSH: same as work2() — ~/.ssh/config → IdentityFile ~/.ssh/corruptedKey_march2023
work2_git_fetch() {
    export GIT_TERMINAL_PROMPT=0
    local github_key="$HOME/.ssh/corruptedKey_march2023"

    # Explicit key first — avoids ssh trying githubkey / other keys with passphrases.
    if [[ -f "$github_key" ]]; then
        if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o IdentitiesOnly=yes -i $github_key -o ConnectTimeout=20" git fetch origin 2>/dev/null; then
            return 0
        fi
    fi

    # ssh-agent on Ubuntu (if march2023 was loaded in an interactive session)
    if [[ -n "${SSH_AUTH_SOCK:-}" ]] && ssh-add -l >/dev/null 2>&1; then
        if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=20" git fetch origin 2>/dev/null; then
            return 0
        fi
    fi

    # Fallback: trust ~/.ssh/config (Host github.com block)
    if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=20" git fetch origin 2>/dev/null; then
        return 0
    fi

    return 1
}

