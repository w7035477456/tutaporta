#============ zap over 1 week old git branches
zap_old_branches() {
    # Define branches you absolutely want to keep safe
    local protected="^(main|master|dev|development)$"
    
    # Get the timestamp for 1 week ago (macOS compatible)
    local cutoff=$(date -v-7d +%s)
    
    echo "Fetching latest remote status..."
    git fetch --prune origin > /dev/null 2>&1

    # Loop through remote branches tracking 'origin'
    # Fixed: added -e to explicitly treat '->' as a pattern match string
    git branch -r | grep 'origin/' | grep -v -e '->' | while read -r remote_branch; do
        # Strip 'origin/' prefix to get the clean branch name
        local branch=${remote_branch#origin/}
        
        # Skip protected branches
        if [[ "$branch" =~ $protected ]]; then
            continue
        fi
        
        # Get last commit timestamp for this remote branch
        local commit_time=$(git log -1 --format="%ct" "origin/$branch" 2>/dev/null)
        
        if [ -n "$commit_time" ] && [ "$commit_time" -lt "$cutoff" ]; then
            echo "❌ Deleting remote branch: origin/$branch"
            git push origin --delete "$branch"
        fi
    done
    
    echo "✨ Cleanup complete."
}
