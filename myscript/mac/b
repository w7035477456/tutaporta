####### superarchive/superrestore ##########
x_restore() {
    #local archive_file="$HOME/x_backup/x_backup.tar.gz.enc"
    local archive_file="./x_backup.tar.gz.enc"
    
    # Use $HOME instead of ~ so tar can resolve the path cleanly
    local restore_dir="$HOME/x_backup/restore" 

    if [ ! -f "$archive_file" ]; then
        echo "Error: Backup file not found at $archive_file"
        return 1
    fi

    # Ensure the target directory physically exists before tar tries to cd into it
    mkdir -p "$restore_dir"

    # Prompt for the decryption password
    read -rs -p "Enter decryption password: " RESTORE_PASS
    echo ""

    echo "Decrypting and restoring to $restore_dir..."

    # Stream, decrypt, and extract straight into your dedicated target folder
    cat "$archive_file" | \
    openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 -pass pass:"$RESTORE_PASS" 2>/dev/null | \
    tar -xzvf - -C "$restore_dir"

    if [ $? -eq 0 ]; then
        echo "Success! Backup has been safely restored to $restore_dir"
        
        # Correct ownership and tighten standard security flags for testing
        chown -R "$USER:staff" "$restore_dir"
        chmod 700 "$restore_dir"
    else
        echo "Restore failed. Incorrect password or corrupted archive."
    fi

    # Clear password from memory
    unset RESTORE_PASS
}

x_backup() {
    local staging_file="/tmp/x_backup.tar.gz.enc"
    local final_dir="$HOME/x_backup"
    local output_file="$final_dir/x_backup.tar.gz.enc"

    # Clean out any old files in the backup directory if it exists
    if [ -d "$final_dir" ]; then
        echo "Cleaning up old files in $final_dir..."
        rm -rf "${final_dir:?}"/*
    fi

    # Ensure the target directory exists before running
    mkdir -p "$final_dir"

    # Prompt for password safely without echoing characters
    read -rs -p "Enter encryption password: " ARCHIVE_PASS
    echo ""
    read -rs -p "Confirm encryption password: " ARCHIVE_PASS_CONFIRM
    echo ""

    if [ "$ARCHIVE_PASS" != "$ARCHIVE_PASS_CONFIRM" ]; then
        echo "Error: Passwords do not match."
        return 1
    fi

    echo "Archiving and encrypting ~/.ssh securely..."

    # 1. Run tar with sudo to read all restricted files.
    # 2. OpenSSL encrypts and saves cleanly to /tmp, preventing terminal pipeline hangs.
    sudo tar -czf - --exclude='*agent*' -C "$HOME" .ssh 2>/dev/null | \
    openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 -pass pass:"$ARCHIVE_PASS" > "$staging_file"

    if [ $? -ne 0 ] || [ ! -s "$staging_file" ]; then
        echo "Encryption step failed."
        rm -f "$staging_file"
        unset ARCHIVE_PASS ARCHIVE_PASS_CONFIRM
        return 1
    fi

    # 3. Move the final file right into your git repository folder.
    echo "Moving archive to $final_dir..."
    mv "$staging_file" "$output_file"

    # 4. Correct ownership back to your user account so git can modify it without sudo.
    chown "$USER:staff" "$output_file"

    if [ $? -eq 0 ]; then
        echo "Success! Secure backup created at: $output_file"
    else
        echo "Failed to move file to your repository directory."
        rm -f "$staging_file"
    fi

    # Clear variables from memory
    unset ARCHIVE_PASS ARCHIVE_PASS_CONFIRM
}

