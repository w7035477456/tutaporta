    echo "🍎 Starting macOS SSH & Env Lockdown..."

    # 1. Set Ownership
    # $(whoami) automatically gets your current Mac username
    sudo chown -R $(whoami):staff ~/.ssh/be

    # 2. Lockdown Directories
    # 700: rwx------ (Only you can enter)
    chmod 700 ~/.ssh
    chmod 700 ~/.ssh/be
    echo "📂 Directories secured."

    # 3. Lockdown Private Keys and .env
    # 600: rw------- (Only you can read/write)
    [ -f ~/.ssh/be/private_key.pem ] && chmod 600 ~/.ssh/be/private_key.pem
    [ -f ~/.ssh/be/.env ] && chmod 600 ~/.ssh/be/.env*
    echo "🔑 Secrets locked (600)."

    # 4. Set Public Keys
    # 644: rw-r--r-- (Standard for public keys)
    [ -f ~/.ssh/be/public_key.pem ] && chmod 644 ~/.ssh/be/public_key.pem
    echo "📋 Public keys set (644)."

    echo "🎯 MAC LOCKDOWN is now secured. Your R-series servers thank you."
}
