gitrevert() {
    # -p allows you to put the prompt string directly in the read command
    read -p "Please enter hash to revert to: " inputHash

    # Exit if the user just hits enter without typing anything
    if [ -z "$inputHash" ]; then
        echo "Error: No hash entered. Operation aborted."
        return 1
    fi

    # The 'Hard Reset' moves the branch pointer and wipes the 'future' commits
    git reset --hard "$inputHash"

    echo "--------------------------------------------------"
    echo "Done! The branch 'tip' is now at $inputHash."
    echo "All commits that were above this have been removed from your local log."
}


