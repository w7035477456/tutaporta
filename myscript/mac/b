test_twilio_verify() {
    # Load from ~/.ssh/be/.env — never hardcode Account SID / Service SID in git.
    local env_file="${HOME}/.ssh/be/.env"
    local account_sid="" service_sid=""
    if [[ -f "$env_file" ]]; then
        # shellcheck disable=SC1090
        set -a
        # shellcheck disable=SC1090
        source <(grep -E '^(TWILIO_ACCOUNT_SID|TWILIO_ServiceSID|TWILIO_SERVICE_SID)=' "$env_file" 2>/dev/null || true)
        set +a
        account_sid="${TWILIO_ACCOUNT_SID:-}"
        service_sid="${TWILIO_ServiceSID:-${TWILIO_SERVICE_SID:-}}"
    fi
    if [[ -z "$account_sid" || -z "$service_sid" ]]; then
        echo "ERROR: set TWILIO_ACCOUNT_SID and TWILIO_ServiceSID in ${env_file}" >&2
        return 1
    fi
    local test_number="+12345678900"
    local auth_token

    # Prompt for the token securely (-s hides the input)
    printf "Enter your Twilio Auth Token: "
    read -s auth_token
    echo "" # Print a newline after the hidden input

    echo "Testing Twilio Verify Service..."

    # Execute curl, capturing both the response body and the HTTP status code
    local response
    response=$(curl -s -w "\n%{http_code}" -X POST "https://verify.twilio.com/v2/Services/${service_sid}/Verifications" \
        --data-urlencode "To=${test_number}" \
        --data-urlencode "Channel=sms" \
        -u "${account_sid}:${auth_token}")

    # Extract the body and the HTTP status code from the response
    local body=$(echo "$response" | sed -e '$ d')
    local status=$(echo "$response" | tail -n 1)

    # Evaluate the result
    if [[ "$status" == "201" || "$status" == "200" ]]; then
        echo "✅ SUCCESS: The Verify Service is active and working perfectly."
    elif [[ "$status" == "401" ]]; then
        echo "❌ ERROR (401): Authentication failed. Your Auth Token is incorrect or has been rotated."
    elif [[ "$status" == "404" ]]; then
        echo "❌ ERROR (404): The Verify Service SID was not found. It may have been deleted."
    else
        echo "❌ ERROR ($status): An unexpected error occurred."
        echo "Details: $body"
    fi
}


