cleancompilebuildfeprod() {
    require_fe_env_for_prod_build || return 1

    local fe_script="${FE_BUILD_SCRIPT:-buildprod}"
    echo "=== FE step: feclean (wipes fe/node_modules + fe/dist; keeps package-lock.json) ==="
    feclean || { echo "ERROR: feclean failed — deploy STOPPED" >&2; return 1; }
    cdsavedir || { echo "ERROR: cdsavedir failed (run savedir / febeprod first) — deploy STOPPED" >&2; return 1; }
    cd ./fe || { echo "ERROR: cd ./fe failed — deploy STOPPED" >&2; return 1; }
    if [[ ! -f package-lock.json ]]; then
        echo "ERROR: missing fe/package-lock.json — deploy STOPPED" >&2
        echo "       Lockfile must be in git. On Mac: commit fe/package-lock.json, pull on Ubuntu." >&2
        return 1
    fi
    # Ubuntu often has NODE_ENV=production; plain npm ci/i then omits devDependencies
    # (sass / javascript-obfuscator) and vite build fails: "sass-embedded" / "sass" not found.
    echo "=== FE step: npm ci --include=dev (NODE_ENV=${NODE_ENV:-unset}; lockfile + sass/obfuscator) ==="
    npm ci --include=dev || { echo "ERROR: npm ci --include=dev failed — deploy STOPPED (fe/dist not built)" >&2; return 1; }
    if [[ ! -d node_modules/sass && ! -d node_modules/sass-embedded ]]; then
        echo "ERROR: neither sass nor sass-embedded installed under fe/node_modules — deploy STOPPED" >&2
        echo "       Check NODE_ENV / npm omit settings. Expected: npm ci --include=dev installs sass." >&2
        return 1
    fi
    echo "=== FE step: npm run $fe_script ==="
    npm run "$fe_script" || {
        echo "ERROR: npm run $fe_script failed — deploy STOPPED (fe/dist not built)" >&2
        return 1
    }
    cdsavedir || return 1
    require_fe_dist || return 1
}
