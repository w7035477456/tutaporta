mylatestbranch() {
    # Sorts branches by committer date (descending) 
    # and picks the top 1 (excluding HEAD)
    local last_branch=$(git for-each-ref --sort=-committerdate refs/heads/ --format='%(refname:short)' | head -n 1)

    if [ -n "$last_branch" ]; then
        echo "Latest branch with activity: $last_branch"
        
        # Optional: Ask if you want to switch to it
        read -p "Would you like to checkout $last_branch? (y/n): " choice
        if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
            git checkout "$last_branch"
        fi
    else
        echo "No local branches found."
    fi
}

latestbranch() {
    # Sorts all branches (local and remote) by committer date, descending
    # We filter out HEAD and then take the very top one
    git for-each-ref --sort=-committerdate refs/heads/ refs/remotes/origin/ \
        --format='%(refname:short)' | sed 's/origin\///' | grep -v 'HEAD' | head -n 1
}
