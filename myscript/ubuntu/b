logBackup() {
    local LOG_DIR="$HOME/code/main/be/logs"
    local BACKUP_BASE="$HOME/dbFolder"
    local ZIP_FILE="$BACKUP_BASE/logs_backup_$(date +%Y%m%d_%H%M%S).zip"

    # 1. Ensure logs source directory exists
    if [ ! -d "$LOG_DIR" ]; then
        echo "Error: Source logs directory $LOG_DIR does not exist."
        return 1
    fi

    # 2. Ensure base backup directory exists
    if [ ! -d "$BACKUP_BASE" ]; then
        echo "Directory $BACKUP_BASE does not exist. Creating it now..."
        mkdir -p "$BACKUP_BASE"
    fi

    # 3. Zip all files inside the log directory
    echo "Zipping all files inside $LOG_DIR..."
    pushd "$LOG_DIR" > /dev/null || return 1
    zip -r "$ZIP_FILE" ./*
    popd > /dev/null || return 1

    if [ ! -f "$ZIP_FILE" ]; then
        echo "Error: Failed to create zip file."
        return 1
    fi

    # 4. Print details and initiate Magic Wormhole transfer
    echo "Created backup archive: $(basename "$ZIP_FILE")"
    ls -lh "$ZIP_FILE"
    echo "Starting wormhole transfer..."

    wormhole send "$ZIP_FILE"
    
    # 5. Cleanup local zip archive
    rm -f "$ZIP_FILE"
}

