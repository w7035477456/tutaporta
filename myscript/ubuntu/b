# Interactive: unlock corruptedKey_march2023 and git fetch until passphrase is correct.
# Wrong passphrase → Permission denied → re-ask; does not proceed until git fetch works.
work2_git_fetch_until_ok() {
    local github_key="${UBUNTU_GIT_KEY:-$HOME/.ssh/corruptedKey_march2023}"
    if [[ ! -f "$github_key" ]]; then
        echo "ERROR: missing GitHub SSH key: $github_key" >&2
        return 1
    fi
    export GIT_SSH_COMMAND="ssh -o IdentitiesOnly=yes -i ${github_key}"

    # Ensure ssh-agent so a correct passphrase is cached for later pull / lfs.
    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
        eval "$(ssh-agent -s)" >/dev/null
    fi

    # Fast path: key already unlocked in agent and GitHub accepts it.
    if GIT_SSH_COMMAND="ssh -o BatchMode=yes -o IdentitiesOnly=yes -i ${github_key}" \
        git fetch 2>/dev/null; then
        git pull || true
        return 0
    fi

    while true; do
        # Drop any bad/partial agent entry so ssh always re-prompts.
        ssh-add -d "$github_key" 2>/dev/null || true

        echo ""
        echo "=== Enter passphrase for ${github_key} ==="
        echo "Wrong passphrase will re-ask — will not proceed until git fetch succeeds (Ctrl-C to abort)."
        if ! ssh-add "$github_key"; then
            echo ""
            echo "Wrong passphrase (ssh-add failed). Try again."
            continue
        fi

        echo "=== git fetch (verifying GitHub access) ==="
        if git fetch; then
            echo "=== GitHub SSH OK ==="
            git pull || true
            return 0
        fi

        echo ""
        echo "ERROR: git fetch failed (Permission denied / publickey)."
        echo "Removing key from agent and asking again."
        ssh-add -d "$github_key" 2>/dev/null || true
    done
}

work2() {
    # Stale interactive shells keep old febeprod (alias expanded into function body).
    # Reload ~/b once, then re-enter so BE/PM2 success is not treated as failure.
    if [[ -z "${_WORK2_RELOADED:-}" ]]; then
        _WORK2_RELOADED=1
        # shellcheck disable=SC1090
        source "$HOME/b" || { echo "ERROR: source ~/b failed" >&2; return 1; }
        work2 "$@"
        local rc=$?
        unset _WORK2_RELOADED
        return "$rc"
    fi
    cd ~/code/main
    ls -latr
    pwd
    # 1) Update remote — loop until SSH passphrase is correct (no proceed on Permission denied)
    if ! work2_git_fetch_until_ok; then
        echo "ERROR: work2 aborted — GitHub SSH auth failed" >&2
        return 1
    fi
    echo "--------------------------------"
    git branch
    echo "--------------------------------"

    # Capture the latest branch name silently
    local latestBranchName=$(latestbranch)

    # 2) Ask for input with the new default
    echo -n "Please input branch name [default: $latestBranchName]: "
    read branch_name

    # 3) Logic: If user presses enter (empty input), use the latest branch
    if [ -z "$branch_name" ]; then
        branch_name="$latestBranchName"
    fi

    # Checkout the determined branch
    if [ -n "$branch_name" ]; then
        git checkout "$branch_name"
    else
        echo "Error: No branch found to checkout."
        return 1
    fi
    echo -e "\n____BRANCH COMMENT:_________________"
    git log -1 --pretty=format:"%C(yellow)%s"
    echo -e "_______________________________________\n"
    read -p "Is this right branch comment ? proceed ? [Y/n]: " CONFIRM
    CONFIRM_LOWER="$(printf '%s' "$CONFIRM" | tr '[:upper:]' '[:lower:]')"
    if [[ "$CONFIRM_LOWER" == "n" ]]; then
        echo "Restore cancelled."
        return 1
    fi

    echo "=== work2: git lfs pull usbzip (real installer zips) ==="
    git lfs pull --include="usbzip/**" 2>/dev/null || git lfs pull 2>/dev/null || true

    # Obfuscate? Y/enter → buildprod; n → buildprodnoobfuscate
    read -p "Do you want Obfuscate (Y/n)? " OBFUSCATE_CHOICE
    local obf_lower
    obf_lower="$(printf '%s' "$OBFUSCATE_CHOICE" | tr '[:upper:]' '[:lower:]')"
