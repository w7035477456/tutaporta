lockdownenv() {
    echo "🔒 Starting SSH & Environment Lockdown..."

    # 1. Set Ownership (User and Group)
    # Using 'a' as seen in your terminal screenshot
    sudo chown -R a:staff ~/.ssh/be

    # 2. Lockdown Directories (Read/Write/Execute for owner ONLY)
    chmod 700 ~/.ssh
    chmod 700 ~/.ssh/be
    echo "✅ Directories secured (700)"

    # 3. Lockdown Private Keys & Secrets (Read/Write for owner ONLY)
    if [ -f ~/.ssh/be/private_key.pem ]; then
        chmod 600 ~/.ssh/be/private_key.pem
        echo "✅ Private key secured (600)"
    fi

    if [ -f ~/.ssh/be/.env ]; then
        chmod 600 ~/.ssh/be/.env*
        echo "✅ Environment files secured (600)"
    fi

    # 4. Set Public Key (Read-only for others, standard for SSH)
    if [ -f ~/.ssh/be/public_key.pem ]; then
        chmod 644 ~/.ssh/be/public_key.pem
        echo "✅ Public key set to 644"
    fi

    echo "🛡️  UBUNTU Lockdown complete. Your R830 and Postgres credentials are restricted."
}
