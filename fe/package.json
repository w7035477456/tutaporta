    "start": "vite",
    "build": "vite build",
    "build:mac": "vite build",
    "builddev": "VITE_API_BASE_URL=https://tutamall.com vite build --minify false --sourcemap true",
    "buildprod": "npm run verify-motion-deps && VITE_API_BASE_URL=https://tutamall.com vite build --minify --sourcemap false && npm run obfuscate",
