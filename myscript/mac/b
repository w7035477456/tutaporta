archive() {
    local target="$1"
    if [ -z "$target" ]; then
        echo " [!] ERROR: No target directory specified."
        return 1
    fi

    # Ensure target is an absolute path for rsync stability
    mkdir -p "$target"
    local abs_target=$(cd "$target"; pwd)
    
    echo " [+] Starting Mac Archive..."
    echo " [+] Destination: $abs_target"
    x_backup
    local items=(
"$HOME/.bash_profile"
"$HOME/.bashrc"
"$HOME/.pm2/dump.pm2"
"$HOME/.profile"
"$HOME/b"
"$HOME/x_backup/x_backup.tar.gz.enc"
