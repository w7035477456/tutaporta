hashCompare() {
read -p "Enter path to the first file: " file1
    read -p "Enter path to the second file: " file2

    # Expand the tilde (~) to the actual home directory path
    file1="${file1/#\~/$HOME}"
    file2="${file2/#\~/$HOME}"

    # Use sudo test to check if files exist, bypassing permission blocks
    if ! sudo test -f "$file1"; then
        echo "Error: File '$file1' does not exist or cannot be accessed."
        return 1
    fi
    if ! sudo test -f "$file2"; then
        echo "Error: File '$file2' does not exist or cannot be accessed."
        return 1
    fi

    # Calculate hashes using sudo and extract just the string portion
    hash1=$(sudo md5sum "$file1" | awk '{print $1}')
    hash2=$(sudo md5sum "$file2" | awk '{print $1}')

    echo "-----------------------------------"
    echo "File 1 MD5: $hash1"
    echo "File 2 MD5: $hash2"
    echo "-----------------------------------"

    # Compare the hash strings
    if [[ "$hash1" == "$hash2" ]]; then
        echo "✅ Result: The files are byte-for-byte identical."
    else
        echo "❌ Result: The files are different."
    fi
}



