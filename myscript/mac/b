dbBackup() {
    cd ~/
    if [ ! -d ~/dbFolder ]; then
        echo "Error: ~/dbFolder/ needs to exist. Please create it first."
        return 1
    fi

    if [ -n "$ALL_BACKUP" ]; then
        FILENAME="${1:-${BACKUP_PREFIX:-dbBackup}}"
    else
        read -p "Enter filename (prefix only) [default='dbBackup']: " FILENAME
        [ -z "$FILENAME" ] && FILENAME="dbBackup"
    fi
    # Shared with miscBackup/photoBackup when run via allBackup.
    BACKUP_PREFIX="$FILENAME"

    TODAY=$(date +"%m%d%Y")
    FULL_PATH="$HOME/dbFolder/${FILENAME}${TODAY}.sql"

    echo "Exporting onlinemallwebsite (schema: helloworldjunktest) to ${FULL_PATH}..."

    # Removed the escaped quotes to fix the "no matching schemas" error
    pg_dump -U test_user1 -h 127.0.0.1 -p 50010 \
            --no-owner --no-privileges \
            -n helloworldjunktest \
            -f "$FULL_PATH" onlinemallwebsite

    if [ -f "$FULL_PATH" ]; then
        ls -latr ~/dbFolder
        echo "Backup complete. Starting wormhole transfer..."
        if wormhole send "$FULL_PATH"; then
            :
        elif [ -n "$ALL_BACKUP" ]; then
            echo "Warning: wormhole send failed (receiver may have rejected or timed out)."
            echo "Local SQL backup exists at $FULL_PATH — continuing to photo backup."
        else
            echo "Error: wormhole send failed."
            return 1
        fi
    else
        echo "Error: pg_dump failed to create the backup file."
        return 1
    fi
}

photoBackup() {
    mkdir -p "$HOME/dbFolder"

    (
        cd "$HOME/dbFolder" || return 1

        local BASE_DIR DATE_STR FILENAME PREFIX
        BASE_DIR="${BASE_STORAGE}/onlinemallwebsite_storage"
        DATE_STR=$(date +%m%d%Y)
        PREFIX="${1:-photoBackup}"
        FILENAME="${PREFIX}${DATE_STR}.tar.gz"

        if [ ! -d "$BASE_DIR" ]; then
            echo "Error: $BASE_DIR not found."
            return 1
        fi

        # users/ = per-member tutadates/photos (current layout); legacy flat photos/ is fallback only.
        local -a storage_dirs=(photos videos users USB_DMG_EXE recordvault-onedrive)
        local -a present=()
        local d
        for d in "${storage_dirs[@]}"; do
            if [ -d "$BASE_DIR/$d" ]; then
                present+=("$d")
            else
                echo "Skip (missing): $BASE_DIR/$d"
            fi
        done

        if [ ${#present[@]} -eq 0 ]; then
            echo "Error: none of ${storage_dirs[*]} found under $BASE_DIR"
            return 1
        fi

        echo "Archiving under $BASE_DIR: ${present[*]}..."
        if COPYFILE_DISABLE=1 tar -czvf "$FILENAME" -C "$BASE_DIR" --exclude='._*' --exclude='.DS_Store' "${present[@]}"; then
            # Profile photos live in users/M*/tutadates/photos; a tar without them
            # restores a working DB with blank avatars, so say so before sending.
            local MEMBER_PHOTOS
            MEMBER_PHOTOS=$(tar -tzf "$FILENAME" 2>/dev/null | grep -c 'users/.*/tutadates/photos/[^/]')
            echo "Archive $FILENAME contains $MEMBER_PHOTOS member photo files (users/M*/tutadates/photos)."
            if [ "$MEMBER_PHOTOS" -eq 0 ]; then
                echo "WARNING: no users/ photos in this archive — run 'source ~/b' and redo photoBackup."
            fi
            ls -lh "$FILENAME"
            echo "Starting wormhole send..."
            wormhole send "$FILENAME"
        else
            echo "Compression failed."
            return 1
        fi
    )
}

