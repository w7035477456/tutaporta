githardrevert() {
    # Prompt the user for the hash
    echo -n "Enter the commit hash to reset to: "
    read -r target_hash

    # Validate that the input is a valid git hash (hexadecimal, between 7 and 40 characters)
    if [[ ! "$target_hash" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
        echo "Error: '$target_hash' is not a valid Git hash format." >&2
        return 1
    fi

    # Optional: Verify if the hash actually exists in the local repository
    if ! git rev-parse --verify --quiet "${target_hash}^{commit}" > /dev/null; then
        echo "Error: Commit '$target_hash' could not be found in this repository." >&2
        return 1
    fi

    # Confirmation warning because reset --hard is destructive
    echo -n "WARNING: This will discard all uncommitted changes. Proceed with reset to $target_hash? (y/N): "
    read -r confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        git reset --hard "$target_hash"
        echo "Successfully reset repository to $target_hash."
    else
        echo "Operation cancelled."
        return 0
    fi
}



