    "verify-motion-deps": "node scripts/verifyMotionDeps.js",
    "cleaninstall": "rm -rf node_modules && npm install",
    "obfuscate": "javascript-obfuscator dist/assets --output dist/assets --compact true --self-defending true",
    "build:ubuntu": "VITE_API_BASE_URL=https://tutamall.com vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\""
