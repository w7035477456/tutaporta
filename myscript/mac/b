rlreset_host() {
  local win="${1:-${RATE_LIMIT_WINDOW_MINUTES:-3}}"
  local max="${2:-${RATE_LIMIT_MAX:-100}}"
  local ip="${3:-${RL_CLIENT_IP:-::1}}"
  local host="${REDIS_HOST:-127.0.0.1}"
  local port="${REDIS_PORT:-6379}"
  redis-cli -h "$host" -p "$port" DEL \
    "rl:w${win}m:n${max}:${ip}" \
    "rlhud:w${win}m:n${max}:${ip}"
}

# Reset Redis-backed rate-limit keys by REDIS_URL.
# Usage: rlreset_url [window_minutes] [max] [client_ip]
# Example: rlreset_url 3 100 ::1
rlreset_url() {
  local win="${1:-${RATE_LIMIT_WINDOW_MINUTES:-3}}"
  local max="${2:-${RATE_LIMIT_MAX:-100}}"
  local ip="${3:-${RL_CLIENT_IP:-::1}}"
  local url="${REDIS_URL:-}"
  if [ -z "$url" ]; then
    echo "REDIS_URL is empty. Use rlreset_host instead or export REDIS_URL."
    return 1
  fi
  case "$url" in
    redis://*|rediss://*) ;;
    *) url="redis://$url" ;;
  esac
  redis-cli -u "$url" DEL \
    "rl:w${win}m:n${max}:${ip}" \
    "rlhud:w${win}m:n${max}:${ip}"
}

