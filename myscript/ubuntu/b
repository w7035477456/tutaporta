bigfiles() {
  local n="${1:-}"

  if [[ -z "$n" ]]; then
    read -rp "How many biggest files? " n
  fi

  if ! [[ "$n" =~ ^[0-9]+$ ]] || (( n < 1 )); then
    echo "bigfiles: need a positive number (e.g. bigfiles 10)" >&2
    return 1
  fi

  local root
  root="$(pwd)"

  find "$root" -type f -print0 2>/dev/null \
    | while IFS= read -r -d '' f; do
        if stat --version >/dev/null 2>&1; then
          stat -c '%s %n' "$f"          # Ubuntu / GNU
        else
          stat -f '%z %N' "$f"          # macOS / BSD
        fi
      done \
    | sort -t' ' -k1,1nr \
    | head -n "$n" \
    | awk '{
        bytes = $1
        $1 = ""
        sub(/^ /, "")
        path = $0
        s = bytes
        split("B KB MB GB TB PB", u, " ")
        i = 1
        while (s >= 1024 && i < 6) { s /= 1024; i++ }
        printf "%10.1f %-4s  %s\n", s, u[i], path
      }'
}


load_be_env_file() {
  local env_file="${1:-$HOME/.ssh/be/.env}"
  [[ -r "$env_file" ]] || return 1
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    if [[ ${#val} -ge 2 ]]; then
      if [[ "${val:0:1}" == '"' && "${val: -1}" == '"' ]]; then
        val="${val:1:${#val}-2}"
      elif [[ "${val:0:1}" == "'" && "${val: -1}" == "'" ]]; then
        val="${val:1:${#val}-2}"
      fi
    fi
    export "$key=$val"
  done <"$env_file"
}

if [ -f "$HOME/.ssh/be/.env" ]; then
  set -a
  load_be_env_file "$HOME/.ssh/be/.env"
  set +a
fi
