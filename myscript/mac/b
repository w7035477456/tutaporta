memcheck() {
  sudo dmidecode -t memory |
  awk '
    /^Memory Device$/ { in_device=1; locator=""; size="" }
    in_device && /^[[:space:]]*Locator:/ && $0 !~ /Bank Locator/ { locator=$0 }
    in_device && /^[[:space:]]*Size:/ { size=$0 }
    in_device && /^$/ {
      if (size !~ /No Module Installed/ && locator != "") {
        print locator
        print size
        print ""
      }
      in_device=0
    }
  '
  sudo edac-util -v
}

