# Mirror per-member media (users/M*/tutadates/{photos,videos}) Mac -> Ubuntu.
# Uses the same hardened SSH as f2 / deployall2: USB key + port 59221, sudo when
# the key is only root-readable. Plain `ssh host` does not work on this box.
# Prints file counts on both sides so a partial transfer is obvious.
# Overrides: SYNC_SRC  SYNC_REMOTE  SYNC_DEST  SYNC_KEY  SYNC_PORT
# Extra rsync args pass through, e.g.  syncStorage --dry-run
syncStorage() {
    local SRC REMOTE DEST KEY PORT RC
    local -a SSH_CMD
    SRC="${SYNC_SRC:-${BASE_STORAGE}/onlinemallwebsite_storage/users/}"
    REMOTE="${SYNC_REMOTE:-lawsen0@192.168.222.202}"
    DEST="${SYNC_DEST:-/mnt/pgdata16/onlinemallwebsite_storage/users/}"
    KEY="${SYNC_KEY:-/Volumes/MSWORD2010/.coredump/corruptedKey_march2024}"
    PORT="${SYNC_PORT:-59221}"

    SSH_CMD=(ssh -o IdentitiesOnly=yes -o ConnectTimeout=10 -i "$KEY" -p "$PORT")
    # f2 needs sudo because the key lives on the USB volume; only add it when required.
    if [ ! -r "$KEY" ]; then
        SSH_CMD=(sudo "${SSH_CMD[@]}")
    fi

    echo "======================================"
    echo " syncStorage: member media mirror"
    echo "======================================"
    echo "  source : $SRC"
    echo "  target : ${REMOTE}:${DEST}"
    echo "  ssh    : ${SSH_CMD[*]}"
    echo

    if [ ! -d "$SRC" ]; then
        echo "Error: source not found: $SRC"
        return 1
    fi
    if [ ! -e "$KEY" ]; then
        echo "Error: SSH key not found: $KEY"
        echo "  Is the MSWORD2010 USB volume mounted?"
        return 1
    fi

    echo "--- LOCAL (before) ---"
    echo -n "  member folders    : "; ls "$SRC" 2>/dev/null | wc -l
    echo -n "  photo files       : "; find "$SRC" -path '*/tutadates/photos/*' -type f 2>/dev/null | wc -l
    echo -n "  video files       : "; find "$SRC" -path '*/tutadates/videos/*' -type f 2>/dev/null | wc -l
    echo -n "  total size        : "; du -sh "$SRC" 2>/dev/null | awk '{print $1}'
    echo

    local REMOTE_COUNT_CMD
    REMOTE_COUNT_CMD="printf '  photo files       : '; find '$DEST' -path '*/tutadates/photos/*' -type f 2>/dev/null | wc -l; \
                      printf '  total size        : '; du -sh '$DEST' 2>/dev/null | awk '{print \$1}'"

    # A dead tunnel is the usual reason this "runs" but copies nothing.
    echo "--- REMOTE (before) ---"
    if ! "${SSH_CMD[@]}" "$REMOTE" "$REMOTE_COUNT_CMD"; then
        echo "  unreachable: SSH to $REMOTE failed"
        echo
        echo "Aborting: check VPN, USB key, and port $PORT."
        echo "  test with: f2"
        return 1
    fi
    echo

    echo "--- RSYNC ---"
    rsync -av --human-readable --itemize-changes --progress --stats \
        -e "${SSH_CMD[*]}" "$@" "$SRC" "${REMOTE}:${DEST}"
    RC=$?
    echo

    if [ "$RC" -ne 0 ]; then
        echo "Error: rsync exited $RC — nothing verified. Check VPN / SSH to $REMOTE."
        return "$RC"
    fi

    echo "--- REMOTE (after) ---"
    "${SSH_CMD[@]}" "$REMOTE" "$REMOTE_COUNT_CMD"
    echo
    echo "Remote photo count should match LOCAL above."

    echo "======================================"
    echo " syncStorage complete"
    echo "======================================"
    echo "IMPORTANT: Next on Ubuntu:  fixstorage && pm2 restart onlinemallwebsite"
    echo "IMPORTANT: Next on Ubuntu:  fixstorage && pm2 restart onlinemallwebsite"
    echo "IMPORTANT: Next on Ubuntu:  fixstorage && pm2 restart onlinemallwebsite"
}


