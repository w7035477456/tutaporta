settag() {
    git tag -n
    local version
    local comment
    local force=""

    echo -n "Enter tag version (e.g., 2.5): "
    read -r version

    # Check if tag already exists locally
    if git rev-parse "v$version" >/dev/null 2>&1; then
        echo -n "Tag v$version already exists. Overwrite? (y/n): "
        read -r response
        if [[ "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
            force="-f"
        else
            echo "Operation cancelled."
            return 1
        fi
    fi

    echo -n "Enter tag description: "
    read -r comment

    # Added $force variable to the command
    git tag $force -a "v$version" -m "$comment"

    if [ $? -eq 0 ]; then
        echo "Successfully created tag v$version"
        # If we forced an update, remind you to force push
        if [ "$force" == "-f" ]; then
            echo "Note: Use 'git push origin v$version --force' to update remote."
        fi
    else
        echo "Failed to create tag."
    fi

    git tag -n
}

