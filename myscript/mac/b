    local file="$1"

    if [ -z "$file" ]; then
        read -p "Enter the filename to clean up: " file
    fi

    # Check if the file exists
    if [ ! -f "$file" ]; then
        echo "Error: File '$file' not found."
        return 1
    fi

    # Fix: Use -i '' to work on macOS without creating a backup file
    sudo sed -i '' \
        -e '/^[[:space:]]*#/d' \
        -e '/^[[:space:]]*$/d' \
        -e 's/@18/@16/g' \
        -e 's/\/17\//\/18\//g' \
        -e 's/-18-/-16-/g' \
        "$file"

    sudo cat "$file"
