resetUserByEmail() {
    # 1. Ask for the email
    read -p "What email of user to wipe? " user_email

    if [ -z "$user_email" ]; then
        echo "Error: No email entered."
        return 1
    fi

    # Connection variables based on your screenshot
    DB_HOST="127.0.0.1"
    DB_PORT="50010"
    DB_USER="test_user1"
    DB_NAME="onlinemallwebsite"
    SCHEMA="helloworldjunktest"

    echo "Processing reset for: $user_email..."

    # 2. Get the singles_id and perform updates/deletes in one transaction block
    # We use -t (tuples only) and -A (unaligned) to make it easier to handle output if needed,
    # but here we execute a multi-statement command.
    psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_NAME -c "
        DO \$\$ 
        DECLARE 
            current_singles_id bigint;
        BEGIN
            -- 0. Find the singles_id
            SELECT singles_id INTO current_singles_id 
            FROM \"$SCHEMA\".singles 
            WHERE email = '$user_email';

            IF NOT FOUND THEN
                RAISE NOTICE 'User with email % not found.', '$user_email';
            ELSE
                -- 1. Set initial_setup_done = false
                UPDATE \"$SCHEMA\".singles 
                SET initial_setup_done = false 
                WHERE singles_id = current_singles_id;

                -- 2. Remove all rows from vsingles_photos
                DELETE FROM \"$SCHEMA\".vsingles_photos 
                WHERE singles_id = current_singles_id;

                RAISE NOTICE 'User % (ID: %) has been reset and photos cleared.', '$user_email', current_singles_id;
            END IF;
        END \$\$;
    "
    
    # Run your follow-up command
    getusersetup
}

