_misc_fix_ownership() {
    local base="$1"
    [[ "$OSTYPE" == "linux-gnu"* ]] || return 0
    # Photos/videos often served by nginx/www-data; bridge installers + vault staging by app user.
    if [ -d "$base/photos" ]; then
        sudo chown -R www-data:www-data "$base/photos"
    fi
    if [ -d "$base/videos" ]; then
        sudo chown -R www-data:www-data "$base/videos"
    fi
    if [ -d "$base/USB_DMG_EXE" ]; then
        sudo chown -R "$(whoami):$(id -gn)" "$base/USB_DMG_EXE"
    fi
    if [ -d "$base/recordvault-onedrive" ]; then
        sudo chown -R "$(whoami):$(id -gn)" "$base/recordvault-onedrive"
    fi
    # Parent must stay writable for future mkdir by sudo restore; keep root or grant user traverse.
    sudo chmod -R u+rwX,g+rX,o+rX "$base/USB_DMG_EXE" "$base/recordvault-onedrive" 2>/dev/null || true
    # Fix common typo folder name if present
    if [ -d "$base/vidoes" ] && [ ! -d "$base/videos" ]; then
        sudo mv "$base/vidoes" "$base/videos"
        sudo chown -R www-data:www-data "$base/videos"
    fi
}

miscBackup() {
    mkdir -p "$HOME/dbFolder"

    (
        cd "$HOME/dbFolder" || return 1

        local BASE_DIR DATE_STR FILENAME
        BASE_DIR="$(_misc_storage_base)"
        DATE_STR=$(date +%m%d%Y)
        FILENAME="miscBackup${DATE_STR}.tar.gz"

        if [ ! -d "$BASE_DIR" ]; then
            echo "Error: $BASE_DIR not found."
            return 1
        fi

        local -a present=()
        local d
        for d in "${_misc_storage_dirs[@]}"; do
            if [ -d "$BASE_DIR/$d" ]; then
                present+=("$d")
            else
                echo "Skip (missing): $BASE_DIR/$d"
            fi
        done

        if [ ${#present[@]} -eq 0 ]; then
            echo "Error: none of ${_misc_storage_dirs[*]} found under $BASE_DIR"
            return 1
        fi

        echo "Archiving under $BASE_DIR: ${present[*]}..."
        # COPYFILE_DISABLE avoids Mac AppleDouble ._ files that break GNU tar on Ubuntu
        if COPYFILE_DISABLE=1 tar -czvf "$FILENAME" -C "$BASE_DIR" --exclude='._*' --exclude='.DS_Store' "${present[@]}"; then
            echo "Starting wormhole send..."
            wormhole send "$FILENAME"
        else
            echo "Compression failed."
            return 1
        fi
    )
}

miscRestore() {
    mkdir -p "$HOME/dbFolder"
    cd ~/dbFolder || { echo "Error: Cannot cd to ~/dbFolder"; return 1; }

    local DEST_BASE
    DEST_BASE="$(_misc_storage_base)"

    local RESTORE_FILE=""
    local EXISTING
    EXISTING=$(ls -t miscBackup*.tar.gz photoBackup*.tar.gz 2>/dev/null | head -n 1)

    if [ -n "$EXISTING" ]; then
        printf "Reuse existing %s without wormhole? (Y/n) " "$EXISTING"
        read -r REUSE
        if [[ "$REUSE" != "n" && "$REUSE" != "N" ]]; then
            RESTORE_FILE="$EXISTING"
        fi
    fi

    if [ -z "$RESTORE_FILE" ]; then
        printf "Input wormhole string: "
        read -r WORMHOLE_CODE
        wormhole receive "$WORMHOLE_CODE"
        RESTORE_FILE=$(ls -t miscBackup*.tar.gz photoBackup*.tar.gz *.tar.gz 2>/dev/null | head -n 1)
    fi

    if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
        echo "Error: File not received (no miscBackup*/photoBackup* .tar.gz in $(pwd))."
        return 1
    fi

    _misc_run mkdir -p "$DEST_BASE"

    local d
    for d in "${_misc_storage_dirs[@]}"; do
        echo "Wiping $DEST_BASE/$d..."
        _misc_run rm -rf "$DEST_BASE/$d"
        _misc_run mkdir -p "$DEST_BASE/$d"
    done
    # Drop typo dir so restore can create correct videos/
    if [ -d "$DEST_BASE/vidoes" ]; then
        echo "Removing typo folder $DEST_BASE/vidoes..."
        _misc_run rm -rf "$DEST_BASE/vidoes"
    fi

    echo "Extracting $RESTORE_FILE to $DEST_BASE (may need sudo password)..."
    local ABS_TAR
    ABS_TAR="$(pwd)/$RESTORE_FILE"
    # --no-same-owner: after sudo extract, don't keep Mac UIDs; we chown next
    if _misc_run tar --no-same-owner --warning=no-unknown-keyword -xzvf "$ABS_TAR" -C "$DEST_BASE"; then
        _misc_fix_ownership "$DEST_BASE"
        echo "Restore complete under $DEST_BASE (${_misc_storage_dirs[*]})"
        # Keep archive for retry; delete only if user wants — leave file (was rm before)
    else
        echo "Error: Extraction failed."
        return 1
    fi
}

