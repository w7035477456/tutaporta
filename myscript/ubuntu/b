# Stop prod first:  pm2 kill
# Then two terminals:  beall    and    feall
# Browse http://localhost:3000 (Vite proxies /api → :40000). Not the HAProxy prod URL.
fkill() {
  local p=$1
  [[ -z "$p" ]] && { echo "Usage: fkill <port>"; return 1; }
  local pids
  pids=$(lsof -ti ":$p" 2>/dev/null) || true
  if [[ -n "$pids" ]]; then
    echo "$pids" | xargs -r kill -9
    echo "[fkill] killed port $p"
  else
    echo "[fkill] nothing on port $p"
  fi
}
killport() { fkill "$@"; }

