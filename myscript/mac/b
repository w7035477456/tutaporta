        read -r WORMHOLE_CODE
        wormhole receive "$WORMHOLE_CODE"
        RESTORE_FILE=$(ls -t photoBackup*.tar.gz miscBackup*.tar.gz *.tar.gz 2>/dev/null | head -n 1)
    fi

    if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
        echo "Error: File not received (no photoBackup*/miscBackup* .tar.gz in $(pwd))."
        return 1
    fi

    if [[ "$(uname -s)" == "Linux" ]]; then
        sudo mkdir -p "$DEST_BASE"
    else
        mkdir -p "$DEST_BASE"
    fi

    # User-owned staging so we can list after sudo tar extract.
    local STAGE ABS_TAR
    STAGE=$(mktemp -d /tmp/photoMergeRestore.XXXXXX)
    ABS_TAR="$(pwd)/$RESTORE_FILE"

    echo "Extracting $RESTORE_FILE to staging (no wipe of $DEST_BASE)..."
    local -a TAR_OPTS=(--no-same-owner)
    if tar --version 2>&1 | grep -qi 'GNU tar'; then
        TAR_OPTS+=(--warning=no-unknown-keyword)
    fi

    local extract_cmd="tar ${TAR_OPTS[*]} -xzvf \"$ABS_TAR\" -C \"$STAGE\""
    if [[ "$(uname -s)" == "Linux" ]]; then
        if ! sudo bash -c "$extract_cmd"; then
            echo "Error: Extraction failed."
            sudo rm -rf "$STAGE"
            return 1
        fi
    else
        if ! eval "$extract_cmd"; then
            echo "Error: Extraction failed."
            rm -rf "$STAGE"
            return 1
        fi
    fi

    echo "Merging into $DEST_BASE (rsync --ignore-existing: existing files win)..."
    local d name
    local list_cmd=(find "$STAGE" -mindepth 1 -maxdepth 1 -print0)
    if [[ "$(uname -s)" == "Linux" ]]; then
        list_cmd=(sudo find "$STAGE" -mindepth 1 -maxdepth 1 -print0)
    fi
    while IFS= read -r -d '' d; do
        name=$(basename "$d")
        if [ -d "$d" ]; then
            if [[ "$(uname -s)" == "Linux" ]]; then
                sudo mkdir -p "$DEST_BASE/$name"
                sudo rsync -a --ignore-existing --human-readable --info=stats2 "$d/" "$DEST_BASE/$name/"
            else
                mkdir -p "$DEST_BASE/$name"
                rsync -a --ignore-existing --human-readable "$d/" "$DEST_BASE/$name/"
            fi
        elif [ -f "$d" ]; then
            if [ ! -e "$DEST_BASE/$name" ]; then
                if [[ "$(uname -s)" == "Linux" ]]; then
                    sudo cp -a "$d" "$DEST_BASE/$name"
                else
                    cp -a "$d" "$DEST_BASE/$name"
                fi
                echo "Added file: $name"
            else
                echo "Keep existing file: $name"
            fi
        fi
    done < <("${list_cmd[@]}")

    if [[ "$(uname -s)" == "Linux" ]]; then
        sudo rm -rf "$STAGE"
        if [ -d "$DEST_BASE/photos" ]; then sudo chown -R www-data:www-data "$DEST_BASE/photos"; fi
        if [ -d "$DEST_BASE/videos" ]; then sudo chown -R www-data:www-data "$DEST_BASE/videos"; fi
        if [ -d "$DEST_BASE/USB_DMG_EXE" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/USB_DMG_EXE"; fi
        if [ -d "$DEST_BASE/recordvault-onedrive" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/recordvault-onedrive"; fi
        if [ -d "$DEST_BASE/users" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/users"; fi
        sudo chmod -R u+rwX,g+rX,o+rX "$DEST_BASE/USB_DMG_EXE" "$DEST_BASE/recordvault-onedrive" "$DEST_BASE/users" 2>/dev/null || true
    else
        rm -rf "$STAGE"
    fi

    echo "Photo/storage MERGE complete under $DEST_BASE (existing files preserved)."
}

photoRestore() {
    cd ~/dbFolder || { echo "Error: Cannot cd to ~/dbFolder"; return 1; }

    local DEST_BASE
    DEST_BASE="${BASE_STORAGE}/onlinemallwebsite_storage"

    local RESTORE_FILE=""
    local EXISTING
    EXISTING=$(ls -t photoBackup*.tar.gz miscBackup*.tar.gz *.tar.gz 2>/dev/null | head -n 1)

    if [ -n "$EXISTING" ]; then
        if [ -n "$ALL_RESTORE" ]; then
            echo "allRestore: skipping reuse of existing $EXISTING (same as answering n)."
        else
            printf "Reuse existing %s without wormhole? (Y/n) " "$EXISTING"
            read -r REUSE
            if [[ "$REUSE" != "n" && "$REUSE" != "N" ]]; then
                RESTORE_FILE="$EXISTING"
            fi
        fi
    fi

    if [ -z "$RESTORE_FILE" ]; then
        printf "Input wormhole string: "
        read -r WORMHOLE_CODE
        wormhole receive "$WORMHOLE_CODE"
        RESTORE_FILE=$(ls -t photoBackup*.tar.gz miscBackup*.tar.gz *.tar.gz 2>/dev/null | head -n 1)
    fi

    if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
        echo "Error: File not received (no photoBackup*/miscBackup* .tar.gz in $(pwd))."
        return 1
    fi

    if [[ "$(uname -s)" == "Linux" ]]; then
        sudo mkdir -p "$DEST_BASE"
    else
        mkdir -p "$DEST_BASE"
    fi

    # users/ = per-member tutadates/photos (current layout); legacy flat photos/ is fallback only.
    local -a storage_dirs=(photos videos users USB_DMG_EXE recordvault-onedrive)
    local d
    for d in "${storage_dirs[@]}"; do
        echo "Wiping $DEST_BASE/$d..."
        if [[ "$(uname -s)" == "Linux" ]]; then
            sudo rm -rf "$DEST_BASE/$d"
            sudo mkdir -p "$DEST_BASE/$d"
        else
            rm -rf "$DEST_BASE/$d"
            mkdir -p "$DEST_BASE/$d"
        fi
    done

    if [ -d "$DEST_BASE/vidoes" ]; then
        echo "Removing typo folder $DEST_BASE/vidoes..."
        if [[ "$(uname -s)" == "Linux" ]]; then
            sudo rm -rf "$DEST_BASE/vidoes"
        else
            rm -rf "$DEST_BASE/vidoes"
        fi
    fi

    echo "Extracting $RESTORE_FILE to $DEST_BASE..."
    local ABS_TAR
    ABS_TAR="$(pwd)/$RESTORE_FILE"

    local -a TAR_OPTS=(--no-same-owner)
    if tar --version 2>&1 | grep -qi 'GNU tar'; then
        TAR_OPTS+=(--warning=no-unknown-keyword)
    fi

    local extract_cmd="tar ${TAR_OPTS[*]} -xzvf \"$ABS_TAR\" -C \"$DEST_BASE\""
    if [[ "$(uname -s)" == "Linux" ]]; then
        if sudo bash -c "$extract_cmd"; then
            if [ -d "$DEST_BASE/photos" ]; then sudo chown -R www-data:www-data "$DEST_BASE/photos"; fi
            if [ -d "$DEST_BASE/videos" ]; then sudo chown -R www-data:www-data "$DEST_BASE/videos"; fi
            if [ -d "$DEST_BASE/USB_DMG_EXE" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/USB_DMG_EXE"; fi
            if [ -d "$DEST_BASE/recordvault-onedrive" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/recordvault-onedrive"; fi
            if [ -d "$DEST_BASE/users" ]; then sudo chown -R "$(whoami):$(id -gn)" "$DEST_BASE/users"; fi
            sudo chmod -R u+rwX,g+rX,o+rX "$DEST_BASE/USB_DMG_EXE" "$DEST_BASE/recordvault-onedrive" "$DEST_BASE/users" 2>/dev/null || true
            echo "Restore complete under $DEST_BASE"
        else
            echo "Error: Extraction failed."
            return 1
        fi
    else
        if eval "$extract_cmd"; then
            echo "Restore complete under $DEST_BASE"
        else
            echo "Error: Extraction failed."
            return 1
        fi
    fi
}



