[Unit]
Description=OnlineMall website uptime monitor (curl + SMS, not PM2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
Environment=HOME=__HOME_DIR__
WorkingDirectory=__HOME_DIR__
ExecStart=__SCRIPT_PATH__
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
