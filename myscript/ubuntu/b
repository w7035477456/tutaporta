# Copy repo usbzip/*.zip → $USB_DMG_EXE ($STORAGE_FOLDER/USB_DMG_EXE). Customer downloads.
publishusbzip() {
  local root="$HOME/code/main"
  local script="$root/scripts/publish-usbzip-to-storage.sh"
  cd "$root" || return 1
  if [[ ! -f "$script" ]]; then
    echo "[publishusbzip] missing $script — pull branch that has scripts/publish-usbzip-to-storage.sh" >&2
    return 1
  fi
  chmod +x "$script" 2>/dev/null || true
  # Copies usbzip/*.zip → $USB_DMG_EXE; refuses Git LFS pointer stubs.
  bash "$script" || return 1
  local dest="${USB_DMG_EXE:-}"
  if [[ -z "$dest" && -f "$HOME/.ssh/be/.env" ]]; then
    dest="$(grep -E "^USB_DMG_EXE=" "$HOME/.ssh/be/.env" | head -1 | cut -d= -f2- | tr -d "\"" | sed "s|#.*||;s/[[:space:]]*$//")"
    local sf
    sf="$(grep -E "^STORAGE_FOLDER=" "$HOME/.ssh/be/.env" | head -1 | cut -d= -f2- | tr -d "\"" | sed "s|#.*||;s/[[:space:]]*$//")"
    dest="${dest//\$\{STORAGE_FOLDER\}/$sf}"
    dest="${dest//\$STORAGE_FOLDER/$sf}"
  fi
  dest="${dest%/}"
  if [[ -z "$dest" ]]; then
    dest="${BASE_STORAGE}/onlinemallwebsite_storage/USB_DMG_EXE"
  fi
  echo "[publishusbzip] verify $dest:"
  ls -lh "$dest"/usbBridgeV3-*.zip 2>&1 || {
    echo "[publishusbzip] ERROR: no zip in $dest after publish" >&2
    return 1
  }
}

