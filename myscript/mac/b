check_mac_perms() {
  # Usage: check_vault_perms [member_id] [vault_name] [app_user]
  local member="${1:-M237112}"
  local vault="${2:-TutaNotes}"
  local app_user="${3:-a}"

  local root_dir
  root_dir=$(grep -E '^LARGE_CHEAP_STORAGE_FOLDER=' ~/.ssh/be/.env 2>/dev/null | cut -d= -f2- | tr -d '\r')

  if [[ -z "$root_dir" ]]; then
    echo "Error: Could not determine ROOT from ~/.ssh/be/.env"
    return 1
  fi

  local member_dir="$root_dir/users/$member"
  local vault_dir="$member_dir/notes/$vault"

  echo "ROOT=$root_dir"
  id "$app_user"
  ps -axo user,pid,command | grep -E '[n]ode' | head -5

  echo "=== Directory Status ==="
  ls -lad "$root_dir" "$root_dir/users" "$member_dir" "$member_dir/notes" "$member_dir/photos" \
    "$vault_dir" "$vault_dir/files" "$vault_dir/photos" 2>/dev/null

  echo "=== Vault Contents ==="
  ls -la "$vault_dir" 2>/dev/null

  echo "=== Path Walk (vault.db) ==="
  local p="$vault_dir/vault.db"
  local d="/"
  for part in $(echo "$p" | tr '/' ' '); do
    d="${d%/}/$part"
    ls -lad "$d" 2>/dev/null || echo "MISSING $d"
  done

  echo "=== Write Probe as $app_user ==="
  sudo -u "$app_user" bash -lc "touch '$vault_dir/.perm_probe' && echo WRITE_OK && rm -f '$vault_dir/.perm_probe'" || echo "WRITE_FAILED"

  echo "=== Find wrong owner (expect empty) ==="
  find "$member_dir" ! -user "$app_user" -exec stat -f 'WRONG_OWNER %Su:%Sg %N' {} \; 2>/dev/null

  echo "=== Find wrong dir mode (expect empty) ==="
  find "$member_dir" -type d ! -perm 755 -exec stat -f 'DIR_MODE_%Mp%Lp %N' {} \; 2>/dev/null

  echo "=== Find wrong file mode (expect empty) ==="
  find "$member_dir" -type f ! -perm 644 -exec stat -f 'FILE_MODE_%Mp%Lp %N' {} \; 2>/dev/null
}



