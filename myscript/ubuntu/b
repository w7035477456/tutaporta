archive() {
  local target="$1"
  if [ -z "$target" ]; then
    echo "[!] ERROR: No target directory specified."
    return 1
  fi

  # Ensure target is an absolute path for rsync stability
  mkdir -p "$target"
  local abs_target=$(cd "$target"; pwd)

  echo "[+] Starting Ubuntu Archive..."
  echo "[+] Destination: $abs_target"
  x_backup
  
  local items=(
"/etc/default/ufw"
"/home/lawsen0/.bash_profile"
"/home/lawsen0/.bashrc"
"/home/lawsen0/.coredump"
"/home/lawsen0/.pm2/dump.pm2"
"/home/lawsen0/.profile"
"/home/lawsen0/b"
"/home/lawsen0/x_backup/x_backup.tar.gz.enc"
"/home/lawsen0/backups"
"/home/lawsen0/buildnvme"
"/home/lawsen0/code/onlinemallwebsite/CRON/cleanup_verifications.sql"
"/home/lawsen0/tuning/tuning.sh"
"/etc/fstab"
"/etc/haproxy/certs/site.pem"
"/etc/haproxy/cloudflare-allowlist.md"
"/etc/haproxy/cloudflare-ips-v4.txt"
"/etc/haproxy/cloudflare-ips-v6.txt"
"/etc/haproxy/haproxy.cfg"
"/etc/netplan/50-cloud-init.yaml"
"/etc/nginx/nginx.conf"
"/etc/nginx/sites-available/protected"
"/etc/postgresql/16/main/postgresql.conf"
"/etc/profile.d/autologout.sh"
"/etc/security/limits.conf"
"/etc/ssh/ssh_config"
"/etc/ssh/sshd_config"
"/etc/sudoers.d/coredump"
"/etc/sysctl.conf"
"/etc/sysctl.d/99-ssh-keepalive.conf"
"/etc/systemd/system/40g-tuning.service"
"/etc/systemd/system/haproxy.service"
"/etc/systemd/system/haproxy.service.d/override.conf"
"/etc/systemd/system/postgresql@16-main.service"
"/etc/ufw/before.rules"
"/etc/ufw/user.rules"
"/etc/ufw/user6.rules"

"/mnt/nvme/pgdata16/pg_hba.conf"
"/mnt/nvme/pgdata16/pg_ident.conf"
"/mnt/nvme/pgdata16/postgresql.auto.conf"
"/mnt/nvme/pgdata16/standby.signal"
"/usr/local/bin/setupufw"
"/usr/local/coredump"
"/usr/local/var/postgresql@16/postgresql.conf"
"/var/lib/postgresql/16/main/postgresql.auto.conf"
"/var/lib/postgresql/16/main/standby.signal"
)

  for item in "${items[@]}"; do
    if [ -e "$item" ]; then
      echo "  -> Backing up: $item"
      # -R (relative) recreates the path inside the target
      # -a (archive) preserves permissions/timestamps
      sudo rsync -Ra "$item" "$abs_target/"
    else
      echo "  [?] Path not found, skipping: $item"
    fi
  done

  echo "[+] Fixing ownership for: $USER"
  sudo chown -R "$USER" "$abs_target"
  echo "[✓] Completed. Files are in: $abs_target"
}

